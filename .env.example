# Copy to .env and fill in. .env is gitignored; this file is the documented template.
# Load into your shell with:  set -a; source .env; set +a

# --- GCP project ---
# Project IDs are globally unique; add a short suffix, e.g. nsw-crash-risk-4821
GCP_PROJECT_ID=nsw-crash-risk-XXXX
# Single region for everything (free-tier Cloud Storage region; keeps loads same-region)
GCP_REGION=us-central1
# Find with: gcloud billing accounts list   (format: XXXXXX-XXXXXX-XXXXXX)
GCP_BILLING_ACCOUNT=

# --- Storage ---
GCS_BUCKET=${GCP_PROJECT_ID}-raw

# --- BigQuery datasets ---
BQ_DATASET_RAW=raw
BQ_DATASET_STAGING=staging
BQ_DATASET_MARTS=marts

# --- Identity ---
# Your own Google account (used to grant you permission to impersonate the pipeline SA)
GCP_USER_EMAIL=
# Service account the pipeline (Airflow + dbt) runs as
PIPELINE_SA=sa-pipeline@${GCP_PROJECT_ID}.iam.gserviceaccount.com
# Impersonation credentials file for this project, kept OUTSIDE the repo (see infra/README.md step 8)
GOOGLE_APPLICATION_CREDENTIALS=${HOME}/.config/nsw-crash-risk/adc.json
